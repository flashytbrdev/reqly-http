{
  "name": "reqly-http",
  "version": "1.2.4",
  "description": "Cliente HTTP moderno e sem dependências, com a API da antiga `request`: callback, stream, Promise, proxy, cookies, multipart e retry.",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "types.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/test.js && node test/esm.test.mjs",
    "test:real": "node test/real.js"
  },
  "engines": {
    "node": ">=14"
  },
  "keywords": [
    "request",
    "http",
    "https",
    "client",
    "fetch",
    "ajax",
    "proxy",
    "cookies",
    "multipart",
    "retry"
  ],
  "license": "MIT"
}
